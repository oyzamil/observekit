{
	"name": "observekit",
	"version": "0.0.4",
	"description": "Unified, tree-shakeable wrapper over MutationObserver, ResizeObserver, IntersectionObserver, PerformanceObserver and ReportingObserver. A typed, zero-dependency replacement for arrive.js-style polling hacks.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/observekit.cjs.js",
	"module": "./dist/observekit.esm.js",
	"unpkg": "./dist/observekit.min.js",
	"jsdelivr": "./dist/observekit.min.js",
	"types": "./dist/observekit.d.ts",
	"exports": {
		".": {
			"types": "./dist/observekit.d.ts",
			"import": "./dist/observekit.esm.js",
			"require": "./dist/observekit.cjs.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build && bun run test",
		"format": "biome format --write ./src",
		"git": "bun run ./scripts/git-helper.ts add-git"
	},
	"keywords": [
		"mutation-observer",
		"resize-observer",
		"intersection-observer",
		"performance-observer",
		"reporting-observer",
		"dom",
		"arrive",
		"arrive.js",
		"observer",
		"browser-extension"
	],
	"author": "M.Muzammil <https://muzammil.work>",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"jsdom": "^25.0.0",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
